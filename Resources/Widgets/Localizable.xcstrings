    "intent.startRecording.description" : {
      "comment" : "zh-Hans translation is provisional and requires human approval.",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launches Provika and begins a new evidence recording."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provikaを起動して、新しい証拠映像の録画を開始します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provika를 열고 새 증거 영상 녹화를 시작합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "启动 Provika 并开始新的证据录制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟動 Provika 並開始新的證據錄影。"
          }
