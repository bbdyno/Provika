    "intent.openCamera.description" : {
      "comment" : "zh-Hans translation is provisional and requires human approval.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens Provika's capture screen. On a locked device it opens the locked-screen camera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provikaの撮影画面を開きます。デバイスがロックされている場合は、ロック画面用カメラを開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provika 촬영 화면을 엽니다. 기기가 잠겨 있으면 잠금 화면 카메라를 엽니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "打开 Provika 拍摄画面。设备锁定时会打开锁定屏幕相机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打開 Provika 拍攝畫面。裝置鎖定時會打開鎖定畫面相機。"
          }
        }
      }
    },
