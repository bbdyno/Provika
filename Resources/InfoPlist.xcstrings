{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "comment": "zh-Hans translation is provisional and requires human approval.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provika uses the camera to record traffic violation evidence videos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Provika는 교통위반 증거 영상 녹화를 위해 카메라를 사용합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Provikaは、交通違反の証拠映像を録画するためにカメラを使用します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Provika 使用相機錄製交通違規的證據影片。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Provika 使用相机录制交通违规证据视频。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "zh-Hans translation is provisional and requires human approval.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provika records GPS coordinates for evidence credibility."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Provika는 증거 신뢰성을 위해 GPS 좌표를 기록합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Provikaは、証拠の信頼性を高めるためにGPS座標を記録します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Provika 會記錄 GPS 座標，以提高證據的可信度。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Provika 记录 GPS 坐标以提高证据可信度。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "zh-Hans translation is provisional and requires human approval.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provika records audio for evidence integrity."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Provika는 증거 무결성을 위해 음성을 함께 녹음합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Provikaは、証拠の完全性を確保するために音声を録音します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Provika 會錄製音訊，以確保證據的完整性。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Provika 录制音频以保障证据完整性。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "zh-Hans translation is provisional and requires human approval.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provika can save recorded videos to your photo library."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Provika가 녹화한 영상을 사진 보관함에 저장할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Provikaで録画したビデオを写真ライブラリに保存できます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Provika 可將錄製的影片儲存到您的照片圖庫。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Provika 可以将录制的视频保存到您的照片图库。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
