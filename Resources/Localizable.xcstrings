    "camera.flash.accessibility.hint": {
      "comment": "zh-Hans translation is provisional and requires human approval.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap to toggle the camera flash."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번 탭하여 카메라 플래시를 전환합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "轻点两下以切换相机闪光灯。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點兩下以切換相機閃光燈。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダブルタップしてカメラのフラッシュを切り替えます。"
          }
        }
      }
    },
