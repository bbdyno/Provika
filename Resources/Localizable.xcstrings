    "settings.signingKey.confirm.message": {
      "comment": "zh-Hans translation is provisional and requires human approval.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordings signed with the existing key can no longer be verified on this device. Continue?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 키로 서명된 영상은 이 기기에서 더 이상 검증할 수 없습니다. 계속하시겠습니까?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用现有密钥签名的录制内容将无法再在此设备上验证。是否继续？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以現有金鑰簽署的錄影將無法再於此裝置上驗證。要繼續嗎？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の鍵で署名された録画は、このデバイスで検証できなくなります。続けますか？"
          }
        }
      }
    },
    "settings.signingKey.confirm.title": {
      "comment": "zh-Hans translation is provisional and requires human approval.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
