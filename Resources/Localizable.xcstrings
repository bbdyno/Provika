    "camera.permission.denied.message" : {
      "comment" : "zh-Hans translation is provisional and requires human approval.",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provika needs camera access to record evidence videos. Please enable it in Settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "証拠映像を録画するには、Provikaにカメラへのアクセスを許可する必要があります。「設定」で有効にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provika는 증거 영상 녹화를 위해 카메라 접근이 필요합니다. 설정에서 허용해주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Provika 需要相机访问权限来录制证据视频。请在“设置”中启用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provika 需要相機存取權限才能錄製證據影片。請在「設定」中開啟權限。"
          }
        }
      }
    },
