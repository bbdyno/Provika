        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新產生簽署金鑰"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名鍵を再生成"
          }
        }
