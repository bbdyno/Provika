    "support.footer" : {
      "comment" : "zh-Hans translation is provisional and requires human approval.",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provika is built and maintained by a solo developer. If this app helped you report a violation or just drive with more peace of mind, consider a one-time tip. Every coffee counts."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provikaは個人開発者が開発・運営しています。このアプリが違反の報告に役立ったり、より安心して運転する助けになったりしたなら、一度限りの応援をご検討ください。コーヒー一杯分の応援が大きな力になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provika는 1인 개발자가 직접 만들고 유지보수합니다. 이 앱이 위반 신고에 도움이 되었거나 운전을 조금 더 든든하게 만들어주었다면 따뜻한 응원 한 번 부탁드립니다. 커피 한 잔도 큰 힘이 됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Provika 由独立开发者制作和维护。如果此应用帮助您报告违规或让您更安心驾驶，欢迎给予一次性支持。每一份支持都很重要。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provika 由獨立開發者一人開發與維護。如果這個 App 曾協助您檢舉違規，或讓您開車時更安心，歡迎提供一次性贊助。每一杯咖啡都是莫大的支持。"
          }
        }
      }
    },
    "support.purchase.accessibility.hint" : {
      "comment" : "zh-Hans translation is provisional and requires human approval.",
